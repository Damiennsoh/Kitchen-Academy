# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Config
NEXT_PUBLIC_APP_NAME="Cooking with Chipo"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# PART 2: PAYMENT & MESSAGING INTEGRATIONS
# ============================================

# Paynow Zimbabwe (for EcoCash / OneMoney / Telecash)
PAYNOW_INTEGRATION_ID=your-paynow-integration-id
PAYNOW_INTEGRATION_KEY=your-paynow-integration-key

# Selar (for USD / Card / Diaspora payments)
SELAR_API_KEY=your-selar-api-key

# Ultramsg WhatsApp API
ULTRAMSG_INSTANCE_ID=your-instance-id
ULTRAMSG_TOKEN=your-ultramsg-token

# Brevo (Sendinblue) Email API
BREVO_API_KEY=your-brevo-api-key
